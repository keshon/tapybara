# --- сборка .NET ---
bin/
obj/
*.user
.vs/
.vscode/

# --- модели распознавания (гигабайты, качаются отдельно) ---
# Ведущий слэш обязателен. Без него шаблон совпадает с папкой ЛЮБОГО уровня
# вложенности, а Git на Windows сравнивает имена без учёта регистра — и
# src/Tapybara.Core/Models/ с исходниками молча не попадал в коммит. Локально
# всё собиралось, потому что файлы лежат на диске; ломалось только у CI,
# который клонирует репозиторий с нуля.
/models/

# --- временное и локальное: сюда же чужие исходники, взятые как справочник ---
/temp/

# --- локальное ---
# Записи и журналы, которые появляются при работе и отладке.
# Исключение для tests: эталонные образцы звука там нужны в репозитории,
# иначе тест, который их использует, невозможно будет добавить.
*.wav
!tests/**/*.wav
*.log
/dist/

# Выход vpk pack: установщик и пакеты обновлений собираются в CI.
/Releases/
