<Window x:Class="TapRecorder.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" Height="46"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False">
    <!--
        Пилюля-индикатор поверх всех окон.

        AllowsTransparency + WindowStyle=None — попиксельная прозрачность,
        благодаря которой скруглённая «пилюля» выглядит пилюлей, а не
        прямоугольником. Это ровно то, что в WinUI 3 сделать нельзя.

        ShowActivated=False плюс WS_EX_NOACTIVATE в code-behind: окно не
        должно забирать фокус НИКОГДА — иначе текст вставится в оверлей,
        а не в приложение, куда диктовали.
    -->
    <Border CornerRadius="23"
            Background="#D9000000"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            MouseLeftButtonUp="OnPillClick"
            Cursor="Hand">
        <Grid Margin="16,0">
            <!-- Состояние «идёт запись» -->
            <StackPanel x:Name="RecordingPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="#FF4D4D" VerticalAlignment="Center" />
                <StackPanel x:Name="LevelBars"
                            Orientation="Horizontal"
                            Height="22"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center" />
                <TextBlock x:Name="ElapsedText"
                           Text="0:00"
                           Foreground="White"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HotkeyHint"
                           Foreground="#8CFFFFFF"
                           FontSize="10"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Состояние «идёт распознавание» -->
            <TextBlock x:Name="TranscribingText"
                       Visibility="Collapsed"
                       Foreground="White"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <!-- Короткая вспышка результата перед скрытием -->
            <TextBlock x:Name="NoteText"
                       Visibility="Collapsed"
                       Foreground="White"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>
