<Window x:Class="TapRecorder.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="580" Height="720"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!--
        Обычное Window, а не ui:FluentWindow: тему и стили контролов даёт
        ControlsDictionary из WPF-UI, подключённый в App.xaml, и стандартные
        TextBox, CheckBox и ComboBox уже выглядят по-современному. Отдельный
        тип окна понадобился бы только ради заголовка со слюдой — цена выше
        пользы, пока окно одно.

        Настройки применяются сразу, без кнопки «ОК»: у каждого поля свой
        независимый смысл, и подтверждать изменение одной галочки нечем.
    -->
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,8">
            <StackPanel x:Name="Sections" />
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <TextBlock x:Name="FooterHint"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="Wrap"
                           MaxWidth="380"
                           HorizontalAlignment="Left" />
                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        MinWidth="96"
                        Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
