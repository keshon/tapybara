<ui:FluentWindow x:Class="TapRecorder.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="640" Height="780"
                 MinWidth="560" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <!--
        FluentWindow, а не обычное Window: он отдаёт заголовок под наш контент
        и включает подложку Mica. Раньше содержимое было тёмным, а системный
        заголовок оставался светлым — глаз ловит это несоответствие сразу,
        даже не понимая, что именно не так.

        Строки настроек — ui:CardControl. Карточка со скруглением, подложкой и
        тонкой рамкой это самый узнаваемый признак интерфейса Windows 11;
        плоский список подписей выглядит «почти похоже, но чужеродно».
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,4,24,16">
            <StackPanel x:Name="Sections" />
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <TextBlock x:Name="FooterHint"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           MaxWidth="400"
                           FontSize="12"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
                <ui:Button x:Name="CloseButton"
                           HorizontalAlignment="Right"
                           MinWidth="100"
                           Appearance="Primary"
                           Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
