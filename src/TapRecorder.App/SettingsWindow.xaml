<ui:FluentWindow x:Class="TapRecorder.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="900" Height="640"
                 MinWidth="860" MaxWidth="1080"
                 MinHeight="480"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <!--
        Разделы — страницы с боковым меню, а не один длинный скролл. Так же
        устроены системные настройки Windows, и причина не в моде: список из
        пяти пунктов виден целиком, а искать нужную настройку прокруткой
        простыни на два экрана невозможно.
    -->
    <ui:FluentWindow.Resources>
        <!--
            Пункт бокового меню: скруглённая подсветка выделенного и акцентная
            полоска слева. Ровно то, что рисует Windows; штатный ListBoxItem
            выглядит как таблица из девяностых.
        -->
        <Style x:Key="SectionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Fill"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="12,10" />
                            <Rectangle x:Name="Bar"
                                       Width="3"
                                       Height="18"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Opacity="0" />
                            <ContentPresenter Margin="12,10" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" ShowMaximize="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SectionList"
                     Grid.Column="0"
                     Margin="12,4,6,12"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource SectionItemStyle}"
                     SelectionChanged="OnSectionChanged" />

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PageTitle"
                           Grid.Row="0"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="12,0,24,14" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="12,0,24,16">
                    <ContentControl x:Name="PageHost" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <TextBlock x:Name="FooterHint"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           MaxWidth="560"
                           FontSize="12"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
                <ui:Button x:Name="CloseButton"
                           HorizontalAlignment="Right"
                           MinWidth="100"
                           Appearance="Primary"
                           Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
