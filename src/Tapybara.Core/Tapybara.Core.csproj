<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ядро без UI: захват звука, распознавание, модели, настройки.
    Сюда НЕ попадает ничего, что знает про окна и WPF, — тогда логику можно
    гонять из консольного харнесса и из тестов, не поднимая интерфейс.
  -->
  <PropertyGroup>
    <RootNamespace>Tapybara.Core</RootNamespace>

    <!-- Нужно генератору LibraryImport: маршалинг, который он пишет за нас,
         работает с указателями. Флаг включён ТОЛЬКО в этом проекте — там, где
         действительно есть interop с Win32, и не расползается на остальные. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Только API-биндинг. Нативные .dll движка подключает исполняемый
         проект (см. Tapybara.Bench) — библиотека не должна навязывать
         выбор между CUDA и CPU. -->
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="NAudio" />
  </ItemGroup>

</Project>
