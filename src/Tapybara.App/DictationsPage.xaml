<UserControl x:Class="Tapybara.App.DictationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:Tapybara.App"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="{StaticResource AppFontSize}">
    <!--
        Диктовки — всё, что надиктовано, с поиском.

        Раньше это было подменю трея на десять строк, обрезанных до
        шестидесяти символов и забытых при выходе. Диктовка, ушедшая не в то
        окно, пропадала вместе с минутой речи.

        Строка устроена как реплика транскрипта: время моноширинным слева,
        текст справа, те же отступы. Два списка текста с временем не должны
        выглядеть как два разных приложения.
    -->
    <Grid Margin="{x:Static app:Tokens.PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,12">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TextTitle}" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText"
                       Style="{StaticResource TextCaption}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <ui:TextBox x:Name="SearchBox"
                    Grid.Row="1"
                    Width="420"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12"
                    Icon="{ui:SymbolIcon Search24}"
                    ClearButtonEnabled="True"
                    TextChanged="OnSearchChanged" />

        <Border x:Name="HistoryOffBanner"
                Grid.Row="2"
                Visibility="Collapsed"
                Margin="0,0,0,12"
                Padding="12,10"
                CornerRadius="{x:Static app:Tokens.ControlRadius}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HistoryOffText" Style="{StaticResource TextBody}" VerticalAlignment="Center" />
                <ui:Button x:Name="HistoryOffButton"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Click="OnOpenSettingsClick" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Panel}">
            <Grid>
                <TextBlock x:Name="EmptyHint"
                           Visibility="Collapsed"
                           Style="{StaticResource TextBodySecondary}"
                           MaxWidth="460"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <ListBox x:Name="EntryList"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="16,8,16,16"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource PlainItemStyle}">
                    <ListBox.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
                    </ListBox.GroupStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:DictationRow}">
                            <Border x:Name="Fill"
                                    CornerRadius="{x:Static app:Tokens.ControlRadius}"
                                    Padding="8,8"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Time}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="{x:Static app:Tokens.Caption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding Words}"
                                                   Style="{StaticResource TextCaption}"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource TranscriptTextStyle}"
                                             Text="{Binding Text, Mode=OneWay}" />

                                    <!-- Действия видны под мышью: в покое строка — только текст. -->
                                    <StackPanel x:Name="Actions"
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                Margin="12,0,0,0"
                                                Opacity="0">
                                        <ui:Button Appearance="Transparent"
                                                   Icon="{ui:SymbolIcon Copy24}"
                                                   Margin="0,0,4,0"
                                                   Tag="{Binding}"
                                                   ToolTip="{Binding CopyHint}"
                                                   Click="OnCopyClick" />
                                        <ui:Button Appearance="Transparent"
                                                   Icon="{ui:SymbolIcon Delete24}"
                                                   Tag="{Binding}"
                                                   ToolTip="{Binding DeleteHint}"
                                                   Click="OnDeleteClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Fill" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fill" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
