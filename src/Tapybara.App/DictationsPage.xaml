<UserControl x:Class="Tapybara.App.DictationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:Tapybara.App"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="{StaticResource AppFontSize}">
    <!--
        Диктовки — всё, что надиктовано, с поиском.

        Раньше это было подменю трея на десять строк, обрезанных до
        шестидесяти символов и забытых при выходе. Диктовка, ушедшая не в то
        окно, пропадала вместе с минутой речи.
    -->
    <UserControl.Resources>
        <Style x:Key="DictationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="6,0,0,10">
            <TextBlock x:Name="PageTitle"
                       FontFamily="{StaticResource AppDisplayFontFamily}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CountText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource AppCaptionFontSize}"
                       Opacity="0.6" />
        </Grid>

        <ui:TextBox x:Name="SearchBox"
                    Grid.Row="1"
                    MaxWidth="560"
                    HorizontalAlignment="Left"
                    Width="560"
                    Margin="0,0,0,8"
                    Icon="{ui:SymbolIcon Search24}"
                    ClearButtonEnabled="True"
                    TextChanged="OnSearchChanged" />

        <Border x:Name="HistoryOffBanner"
                Grid.Row="2"
                Visibility="Collapsed"
                Margin="0,0,0,8"
                Padding="12,9"
                CornerRadius="6"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
            <Grid>
                <TextBlock x:Name="HistoryOffText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,140,0" />
                <ui:Button x:Name="HistoryOffButton"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Click="OnOpenSettingsClick" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <TextBlock x:Name="EmptyHint"
                           Visibility="Collapsed"
                           MaxWidth="460"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.65"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <ListBox x:Name="EntryList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,4,8,12"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource DictationItemStyle}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource AppCaptionFontSize}"
                                               Opacity="0.6"
                                               Margin="10,12,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:DictationRow}">
                            <Border x:Name="Fill" CornerRadius="6" Padding="10,8" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding Time}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="12"
                                                   Opacity="0.75" />
                                        <TextBlock Text="{Binding Words}"
                                                   FontSize="11"
                                                   Opacity="0.5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource TranscriptTextStyle}"
                                             Text="{Binding Text, Mode=OneWay}" />

                                    <StackPanel x:Name="Actions"
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                Margin="10,0,0,0"
                                                Opacity="0.35">
                                        <ui:Button Appearance="Transparent"
                                                   Icon="{ui:SymbolIcon Copy24}"
                                                   Padding="6"
                                                   Tag="{Binding}"
                                                   ToolTip="{Binding CopyHint}"
                                                   Click="OnCopyClick" />
                                        <ui:Button Appearance="Transparent"
                                                   Icon="{ui:SymbolIcon Delete24}"
                                                   Padding="6"
                                                   Tag="{Binding}"
                                                   ToolTip="{Binding DeleteHint}"
                                                   Click="OnDeleteClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Fill" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fill" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
