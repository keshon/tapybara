<ui:FluentWindow x:Class="Tapybara.App.ConfirmWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:components="clr-namespace:Tapybara.App.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="480"
                 MinHeight="0" WindowBackdropType="None" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="{StaticResource AppFontSize}">
    <!--
        Вопрос с двумя-тремя ответами.

        Не системный MessageBox, и причина не в красоте. У MessageBox кнопки
        называются «Да», «Нет» и «Отмена» — переименовать их нельзя. Для
        вопроса «перенести модели или оставить» это никуда не годится: «Да» и
        «Нет» на таком вопросе означают почти одно и то же, а разница — в
        полутора гигабайтах, которые сейчас куда-то поедут. Кнопка должна
        говорить, что она сделает.

        Заодно появляется место для путей: человек, меняющий папку моделей,
        обязан видеть, откуда и куда.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,8,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <ui:SymbolIcon x:Name="HeadingIcon"
                               Symbol="QuestionCircle24"
                               FontSize="28"
                               Margin="0,0,16,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="HeadingText"
                           FontFamily="{StaticResource AppDisplayFontFamily}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="BodyText"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,0,0,14" />

            <Border x:Name="DetailCard"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel x:Name="DetailRows" />
            </Border>
            <StackPanel x:Name="ContentRows" Visibility="Collapsed" />
        </StackPanel>

        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton"
                           components:ControlSizing.Compact="True" MinWidth="96"
                           Margin="0,0,8,0"
                           IsCancel="True"
                           Click="OnCancelClick" />
                <ui:Button x:Name="SecondaryButton"
                           components:ControlSizing.Compact="True" MinWidth="96"
                           Margin="0,0,8,0"
                           Visibility="Collapsed"
                           Click="OnSecondaryClick" />
                <ui:Button x:Name="PrimaryButton"
                           components:ControlSizing.Compact="True" MinWidth="96"
                           Appearance="Primary"
                           IsDefault="True"
                           Click="OnPrimaryClick" />
            </WrapPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
