<UserControl x:Class="Tapybara.App.CallsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:Tapybara.App"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="{StaticResource AppFontSize}">
    <!--
        Звонки — страница главного окна.

        Три колонки: список, звонок, голоса. Главное в звонке — транскрипт,
        и он внутри окна. Раньше здесь были только чипы участников и
        заметка, а сам текст открывался во внешнем редакторе, где ни
        послушать место, ни поправить, кто что сказал, было нельзя.

        Левый край внутри карточки звонка один на всё — 24 пикселя: заголовок,
        подпись, кнопки, вкладки, метки времени. Раньше каждый элемент стоял
        в своём контейнере со своим отступом, и края расходились на 13 пикселей.

        Состояние выводится из файлов на диске (см. CallLibrary), поэтому оно
        не расходится с реальностью после падения приложения и переживает
        правку папки руками — а папку правят, это её назначение.
    -->
    <Grid Margin="{x:Static app:Tokens.PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition x:Name="VoicesColumn" Width="320" />
        </Grid.ColumnDefinitions>

        <!-- список -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Кнопка записи — во всю ширину колонки, под заголовком: это главное
                 действие страницы, а не иконка рядом с ним. -->
            <StackPanel Grid.Row="0" Margin="4,0,8,12">
                <TextBlock x:Name="ListTitle" Style="{StaticResource TextTitle}" />
                <ContentControl x:Name="RecordHost" Margin="-4,12,0,0" />
            </StackPanel>

            <ui:TextBox x:Name="SearchBox"
                        Grid.Row="1"
                        Margin="0,0,8,8"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        TextChanged="OnSearchChanged" />

            <ListBox x:Name="CallList"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     ItemContainerStyle="{StaticResource ListRowStyle}"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
                </ListBox.GroupStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type app:CallRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource TextBodyStrong}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="NoWrap"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource Badge}"
                                    Margin="8,1,0,0"
                                    Visibility="{Binding BadgeVisibility}"
                                    Background="{Binding StateBackground}">
                                <TextBlock Text="{Binding StateText}"
                                           FontSize="{x:Static app:Tokens.Caption}"
                                           Foreground="{Binding StateForeground}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint"
                       Grid.Row="2"
                       Visibility="Collapsed"
                       Style="{StaticResource TextBodySecondary}"
                       Margin="12,24,12,0"
                       VerticalAlignment="Top" />

            <!-- Итоги — отдельной строкой под чертой, а не вплотную к последней группе. -->
            <Border Grid.Row="3"
                    Margin="0,8,8,0"
                    Padding="12,8,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="TotalsText" Style="{StaticResource TextCaption}" />
            </Border>
        </Grid>

        <!-- звонок -->
        <Border Grid.Column="1" Style="{StaticResource Panel}">
            <Grid>
                <TextBlock x:Name="NothingSelected"
                           Style="{StaticResource TextBodySecondary}"
                           Margin="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <Grid x:Name="DetailPane" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,20,24,12">
                        <TextBox x:Name="TitleBox"
                                 Style="{StaticResource InlineTitleStyle}"
                                 KeyDown="OnTitleKeyDown"
                                 LostKeyboardFocus="OnTitleLostFocus" />
                        <TextBlock x:Name="DetailMeta"
                                   Style="{StaticResource TextCaption}"
                                   Margin="0,4,0,16" />

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button x:Name="ListenButton"
                                           Margin="0,0,8,0"
                                           Icon="{ui:SymbolIcon Play24}"
                                           Click="OnListenClick" />
                                <ui:Button x:Name="CopyButton"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           Click="OnCopyClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button x:Name="FolderButton"
                                           Margin="0,0,8,0"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Click="OnFolderClick" />
                                <ui:Button x:Name="MoreButton"
                                           Icon="{ui:SymbolIcon MoreHorizontal24}"
                                           Click="OnMoreClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- вкладки — по левому краю содержимого, под ними черта -->
                    <Border Grid.Row="1"
                            Padding="24,0"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TranscriptTab"
                                         GroupName="CallTabs"
                                         IsChecked="True"
                                         Style="{StaticResource TabHeader}"
                                         Checked="OnTabChecked" />
                            <RadioButton x:Name="NoteTab"
                                         GroupName="CallTabs"
                                         Style="{StaticResource TabHeader}"
                                         Checked="OnTabChecked" />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="TranscriptView" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="Banner"
                                Grid.Row="0"
                                Visibility="Collapsed"
                                Margin="24,16,24,0"
                                Padding="12,10"
                                CornerRadius="{x:Static app:Tokens.ControlRadius}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <!--
                                Значок и текст — одна группа, выровненная по
                                центру баннера. Значок стоял сверху баннера,
                                а текст — по центру рядом с кнопкой, и значок
                                «улетал» вверх от строки, к которой относится.
                                Внутри группы значок держится первой строки:
                                текст бывает в две.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon x:Name="BannerIcon"
                                                   Symbol="Info24"
                                                   FontSize="16"
                                                   Margin="0,2,12,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="BannerText" Style="{StaticResource TextBody}" />
                                        <ProgressBar x:Name="BannerProgress"
                                                     Visibility="Collapsed"
                                                     Margin="0,8,0,2"
                                                     Height="4"
                                                     Maximum="100" />
                                    </StackPanel>
                                </Grid>
                                <ui:Button x:Name="BannerButton"
                                           Grid.Column="1"
                                           Margin="12,0,0,0"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"
                                           Click="OnBannerButtonClick" />
                            </Grid>
                        </Border>

                        <!--
                            Отступ списка 16 + отступ строки 8 = 24: метки времени
                            стоят на той же вертикали, что заголовок звонка.
                        -->
                        <ListBox x:Name="LineList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="16,8,16,16"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ItemContainerStyle="{StaticResource PlainItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:TranscriptLineRow}">
                                    <!--
                                        Метка времени всегда на строке текста, а имя — отдельной
                                        строкой над обоими. Раньше время вставало то на уровень
                                        имени, то на уровень текста, и колонка времени прыгала.
                                    -->
                                    <Border x:Name="LineFill"
                                            CornerRadius="{x:Static app:Tokens.ControlRadius}"
                                            Padding="8,3"
                                            Margin="{Binding Spacing}"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button Grid.Row="0"
                                                    Grid.Column="1"
                                                    Style="{StaticResource FlatLinkButton}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,2"
                                                    Visibility="{Binding SpeakerVisibility}"
                                                    Tag="{Binding}"
                                                    Click="OnSpeakerClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8"
                                                             Margin="0,1,8,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding SpeakerBrush}" />
                                                    <TextBlock Text="{Binding Speaker}"
                                                               FontWeight="SemiBold"
                                                               FontStyle="{Binding SpeakerFontStyle}"
                                                               Foreground="{Binding SpeakerForeground}" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Row="1"
                                                    Grid.Column="0"
                                                    Style="{StaticResource FlatLinkButton}"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,2,0,0"
                                                    Tag="{Binding}"
                                                    ToolTip="{Binding PlayHint}"
                                                    Click="OnStampClick">
                                                <TextBlock Text="{Binding Stamp}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="{x:Static app:Tokens.Caption}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </Button>

                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Style="{StaticResource TranscriptTextStyle}"
                                                     Text="{Binding Text, Mode=OneWay}"
                                                     Tag="{Binding}"
                                                     ContextMenuOpening="OnLineContextMenuOpening" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="LineFill" Property="Background"
                                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer x:Name="LegacyScroll"
                                      Grid.Row="1"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="24,16,24,16">
                            <TextBox x:Name="LegacyText" Style="{StaticResource TranscriptTextStyle}" />
                        </ScrollViewer>
                    </Grid>

                    <ui:TextBox x:Name="NoteBox"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                Margin="24,16,24,24"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalContentAlignment="Top"
                                VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Border>

        <!-- голоса -->
        <Border x:Name="VoicesPane"
                Grid.Column="2"
                Margin="12,0,0,0"
                Style="{StaticResource Panel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,20,16,16">
                <StackPanel x:Name="VoicesHost" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
