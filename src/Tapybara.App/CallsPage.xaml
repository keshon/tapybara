<UserControl x:Class="Tapybara.App.CallsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:Tapybara.App"
             xmlns:components="clr-namespace:Tapybara.App.Controls"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="{StaticResource AppFontFamily}"
             FontSize="{StaticResource AppFontSize}">
    <UserControl.Resources>
        <Style x:Key="CoveredWorkspacePanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=ImportPane}" Value="Visible">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!--
        Звонки — страница главного окна.

        Три колонки: список, звонок, голоса. Главное в звонке — транскрипт,
        и он внутри окна. Раньше здесь были только чипы участников и
        заметка, а сам текст открывался во внешнем редакторе, где ни
        послушать место, ни поправить, кто что сказал, было нельзя.

        Левый край внутри карточки звонка один на всё — 24 пикселя: заголовок,
        подпись, кнопки, вкладки, метки времени. Раньше каждый элемент стоял
        в своём контейнере со своим отступом, и края расходились на 13 пикселей.

        Состояние выводится из файлов на диске (см. CallLibrary), поэтому оно
        не расходится с реальностью после падения приложения и переживает
        правку папки руками — а папку правят, это её назначение.
    -->
    <Grid x:Name="PageRoot" Margin="{x:Static app:Tokens.PagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LibraryColumn" Width="{x:Static app:Tokens.LibraryColumn}"
                              MinWidth="{x:Static app:Tokens.LibraryMinWidth}" MaxWidth="{x:Static app:Tokens.LibraryMaxWidth}" />
            <ColumnDefinition Width="{x:Static app:Tokens.GutterColumn}" />
            <ColumnDefinition Width="*" MinWidth="{x:Static app:Tokens.EditorMinWidth}" />
            <ColumnDefinition x:Name="PeopleGutter" Width="{x:Static app:Tokens.GutterColumn}" />
            <ColumnDefinition x:Name="VoicesColumn" Width="320" MaxWidth="{x:Static app:Tokens.PeopleMaxWidth}" />
        </Grid.ColumnDefinitions>

        <!-- список -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <components:SectionHeader Grid.Row="0" Margin="4,0,0,12">
                <components:SectionHeader.TitleContent>
                    <TextBlock x:Name="ListTitle" Style="{StaticResource TextTitle}" />
                </components:SectionHeader.TitleContent>
                <components:SectionHeader.ActionContent>
                    <ContentControl x:Name="RecordHost" />
                </components:SectionHeader.ActionContent>
            </components:SectionHeader>

            <components:SearchFilterBar x:Name="LibrarySearch" Grid.Row="1" Margin="0,0,0,8">
                <components:SearchFilterBar.ActionContent>
                    <ui:Button x:Name="NewTranscriptionButton" Click="OnNewTranscription"
                               Margin="8,0,0,0" Icon="{ui:SymbolIcon Add24}" />
                </components:SearchFilterBar.ActionContent>
            </components:SearchFilterBar>

            <ListBox x:Name="CallList" Margin="0"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     ItemContainerStyle="{StaticResource ListRowStyle}"
                    SelectionChanged="OnSelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
                </ListBox.GroupStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type app:CallRow}">
                        <Grid ContextMenuOpening="OnCallRowContextMenuOpening">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource TextBodyStrong}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="NoWrap"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <components:StatusBadge Grid.Column="1"
                                    Margin="8,1,0,0"
                                    Visibility="{Binding BadgeVisibility}"
                                    Text="{Binding StateText}"
                                    BackgroundKey="{Binding StateBackgroundKey}"
                                    ForegroundKey="{Binding StateForegroundKey}" />
                            <Button Grid.Column="2" Style="{StaticResource SquareIconButton}" Margin="4,0,0,0"
                                    Click="OnCallRowMoreClick" ToolTip="{Binding ActionsHint}" AutomationProperties.Name="{Binding ActionsHint}">
                                <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint"
                       Grid.Row="2"
                       Visibility="Collapsed"
                       Style="{StaticResource TextBodySecondary}"
                       Margin="12,24,12,0"
                       VerticalAlignment="Top" />

            <!-- Итоги — отдельной строкой под чертой, а не вплотную к последней группе. -->
            <Border Grid.Row="3"
                    Margin="0,8,0,0"
                    Padding="12,12"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock x:Name="TotalsText" Style="{StaticResource TextCaption}" />
            </Border>
        </Grid>

        <!-- звонок -->
        <GridSplitter x:Name="LibrarySplitter" Grid.Column="1" Style="{StaticResource PanelSplitter}" />
        <Border Grid.Column="2" Style="{StaticResource CoveredWorkspacePanel}">
            <Grid>
                <TextBlock x:Name="NothingSelected"
                           Style="{StaticResource TextBodySecondary}"
                           Margin="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <Grid x:Name="DetailPane" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="24,20,24,4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=Banner}" Value="Collapsed">
                                        <Setter Property="Margin" Value="24,20,24,12" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBox x:Name="TitleBox"
                                 Style="{StaticResource InlineTitleStyle}"
                                 KeyDown="OnTitleKeyDown"
                                 LostKeyboardFocus="OnTitleLostFocus" />
                        <TextBlock x:Name="DetailMeta"
                                   Style="{StaticResource TextCaption}"
                                   Margin="0,4,0,12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <components:HistoryBar x:Name="EditHistory" Margin="0,0,12,0" />
                            <ui:Button x:Name="ExportButton" Grid.Column="1" components:ControlSizing.Compact="True"
                                       Click="OnExportClick" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5"
                                          Stroke="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0"
                                          Data="M3,10 L3,14 L13,14 L13,10 M8,11 L8,2 M4,6 L8,2 L12,6" />
                                    <TextBlock x:Name="ExportCaption" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                            <ToggleButton x:Name="NotesToggle" Style="{StaticResource IconToggleButton}" Grid.Column="2" components:ControlSizing.IconOnly="True"
                                          Checked="OnNotesToggle" Unchecked="OnNotesToggle">
                                <ui:SymbolIcon Symbol="Note24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            </ToggleButton>
                            <ui:Button x:Name="FindButton" Grid.Column="3" components:ControlSizing.IconOnly="True"
                                       Icon="{ui:SymbolIcon Search24}" Click="OnFindClick" Margin="8,0,0,0" />
                            <ui:Button x:Name="ReviewButton" Grid.Column="5" components:ControlSizing.IconOnly="True"
                                       Icon="{ui:SymbolIcon People24}" Click="OnReviewClick" Margin="0,0,8,0" />
                            <ui:Button x:Name="MoreButton" Grid.Column="6" components:ControlSizing.IconOnly="True"
                                       Icon="{ui:SymbolIcon MoreHorizontal24}" Click="OnMoreClick" />
                        </Grid>
                        <ui:TextBox x:Name="NoteBox" Visibility="Collapsed" Margin="0,8,0,0"
                                    MinHeight="64" MaxHeight="96" AcceptsReturn="True" TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <Grid x:Name="TranscriptView" Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="Banner"
                                Grid.Row="0"
                                Visibility="Collapsed"
                                Margin="24,8,24,8"
                                Padding="12,10"
                                CornerRadius="{x:Static app:Tokens.ControlRadius}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <!--
                                Значок и текст — одна группа, выровненная по
                                центру баннера. Значок стоял сверху баннера,
                                а текст — по центру рядом с кнопкой, и значок
                                «улетал» вверх от строки, к которой относится.
                                Внутри группы значок держится первой строки:
                                текст бывает в две.
                            -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon x:Name="BannerIcon"
                                                   Symbol="Info24"
                                                   FontSize="16"
                                                   Margin="0,2,12,0"
                                                   VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="BannerText" Style="{StaticResource TextBody}" />
                                        <ProgressBar x:Name="BannerProgress"
                                                     Visibility="Collapsed"
                                                     Margin="0,8,0,2"
                                                     Height="4"
                                                     Maximum="100" />
                                    </StackPanel>
                                </Grid>
                                <ui:Button x:Name="BannerButton"
                                           Grid.Column="1"
                                           Margin="12,0,0,0"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"
                                           Click="OnBannerButtonClick" />
                            </Grid>
                        </Border>

                        <!--
                            Отступ списка 4 + отступ строки 20 = 24: метки времени
                            стоят на той же вертикали, что заголовок звонка. Широкий
                            левый отступ строки — место для ▶ при наведении и полосы
                            звучащей реплики, не сдвигающих колонку времени.
                        -->
                        <components:FindReplaceBar x:Name="DocumentSearch" Grid.Row="1" Visibility="Collapsed" Margin="24,8,24,8" />
                        <Border Grid.Row="2" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                IsHitTestVisible="False" Panel.ZIndex="1" />
                        <ListBox x:Name="LineList"
                                 FocusVisualStyle="{StaticResource QuietKeyboardFocus}"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="4,8,16,16"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ItemContainerStyle="{StaticResource PlainItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:TranscriptLineRow}">
                                    <!--
                                        Метка времени всегда на строке текста, а имя — отдельной
                                        строкой над обоими. Раньше время вставало то на уровень
                                        имени, то на уровень текста, и колонка времени прыгала.
                                    -->
                                    <Border x:Name="LineFill"
                                            CornerRadius="{x:Static app:Tokens.ControlRadius}"
                                            Margin="{Binding Spacing}"
                                            Background="Transparent">
                                        <Grid>
                                            <Border x:Name="SearchFill" CornerRadius="{x:Static app:Tokens.ControlRadius}"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Opacity="0.12" Visibility="Collapsed" IsHitTestVisible="False" />
                                            <!-- Активные интервалы обозначены полосой; без выдуманного выравнивания слов. -->
                                            <Border x:Name="NowBar"
                                                    Width="3"
                                                    Margin="0,4"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="1.5"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Visibility="Collapsed" />
                                            <Grid Margin="20,3,8,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="32" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Button Grid.Row="0"
                                                        Grid.Column="1"
                                                        Style="{StaticResource FlatLinkButton}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,0,2"
                                                        Visibility="{Binding SpeakerVisibility}"
                                                        Click="OnSpeakerClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8"
                                                                 Margin="0,1,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{Binding SpeakerBrush}" />
                                                        <TextBlock Text="{Binding Speaker}"
                                                                   FontWeight="SemiBold"
                                                                   FontStyle="{Binding SpeakerFontStyle}"
                                                                   Foreground="{Binding SpeakerForeground}" />
                                                    </StackPanel>
                                                </Button>

                                                <components:TranscriptLineActions Grid.Row="1" Grid.Column="0"
                                                         ShowMenuButton="False"
                                                         Stamp="{Binding Stamp}" IsExcerptPlaying="{Binding IsExcerptPlaying}"
                                                         Tag="{Binding ElementName=LineEditor}"
                                                         TimingShiftRequested="OnTimestampShift" SeekRequested="OnStampClick" LockedPlayRequested="OnFragmentClick"
                                                         MenuRequested="OnLineActionsClick" />

                                                <components:InlineTextEditor x:Name="LineEditor" MinHeight="32" VerticalContentAlignment="Center" Grid.Row="1"
                                                         Grid.Column="1"
                                                         Style="{StaticResource TranscriptTextStyle}"
                                                         IsReadOnly="False"
                                                         Text="{Binding Text, Mode=OneWay}"
                                                         Loaded="OnEditorLoaded"
                                                         GotKeyboardFocus="OnEditorFocused"
                                                         DocumentMenuOpening="OnLineContextMenuOpening" />
                                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SquareIconButton}"
                                                        Tag="{Binding ElementName=LineEditor}" Click="OnLineActionsClick"
                                                        ToolTip="{Binding ActionsHint}" AutomationProperties.Name="{Binding ActionsHint}">
                                                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="LineFill" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="LineFill" Property="Background"
                                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                            <Setter TargetName="SearchFill" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="NowBar" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer x:Name="LegacyScroll"
                                      Grid.Row="2"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="24,16,24,16">
                            <TextBox x:Name="LegacyText" Style="{StaticResource TranscriptTextStyle}" />
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="3" Padding="24,8,24,12"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <components:AudioTimelineView x:Name="Timeline" Visibility="Collapsed" Margin="0,0,0,8" />
                            <components:AudioTransportBar x:Name="Transport">
                                <components:AudioTransportBar.Tools>
                                    <ToggleButton x:Name="TimelineToggle" Style="{StaticResource IconToggleButton}" components:ControlSizing.IconOnly="True"
                                                  Checked="OnTimelineToggle" Unchecked="OnTimelineToggle">
                                        <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                              Data="M1,8 L1,10 M4,4 L4,14 M7,1 L7,16 M10,4 L10,14 M13,6 L13,12 M16,8 L16,10" />
                                    </ToggleButton>
                                </components:AudioTransportBar.Tools>
                            </components:AudioTransportBar>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- голоса -->
        <Border x:Name="VoicesPane"
                Grid.Column="4"
                Style="{StaticResource CoveredWorkspacePanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,20,16,16">
                <StackPanel x:Name="VoicesHost" />
            </ScrollViewer>
        </Border>
        <Border x:Name="ImportPane" Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="10"
                Style="{StaticResource Panel}" Visibility="Collapsed">
            <Grid Margin="24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="ImportTitle" Style="{StaticResource TextTitle}" VerticalAlignment="Center" />
                    <ui:Button x:Name="CloseImportButton" HorizontalAlignment="Right" Click="OnCloseImport"
                               Icon="{ui:SymbolIcon Dismiss24}" components:ControlSizing.IconOnly="True" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,32,0,24">
                        <Grid Height="260" AllowDrop="True" PreviewDragOver="OnImportDragOver" Drop="OnImportDrop">
                            <ui:Button x:Name="BrowseImportButton" Click="OnBrowseImport" HorizontalContentAlignment="Stretch"
                                       VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Appearance="Transparent" Padding="24" CornerRadius="{x:Static app:Tokens.CardRadius}">
                                <ui:Button.Template>
                                    <ControlTemplate TargetType="ui:Button">
                                        <Grid>
                                            <Rectangle x:Name="DropOutline" Fill="Transparent" Stroke="{DynamicResource CardStrokeColorDefaultBrush}"
                                                       StrokeThickness="1" StrokeDashArray="4,3"
                                                       RadiusX="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                                                       RadiusY="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DropOutline" Property="Stroke" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="DropOutline" Property="Stroke" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ui:Button.Template>
                                <StackPanel>
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,24" />
                                    <TextBlock x:Name="ImportDropTitle" Style="{StaticResource TextTitle}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ImportDropHint" Style="{StaticResource TextBodySecondary}" TextAlignment="Center" Margin="0,12,0,0" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                        <WrapPanel Margin="0,24,0,0">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock x:Name="ImportLanguageLabel" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
                                <ComboBox x:Name="ImportLanguage" Width="260" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Code" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="ImportSpeakersLabel" Style="{StaticResource TextCaption}" Margin="0,0,0,8" />
                                <ComboBox x:Name="ImportSpeakers" Width="180" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Count" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="ImportStatusText" Style="{StaticResource TextBodySecondary}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        <ProgressBar x:Name="ImportProgress" IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="Collapsed" />
                        <ui:Button x:Name="CancelImportButton" HorizontalAlignment="Left" Click="OnCancelImport" Margin="0,16,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <GridSplitter x:Name="PeopleSplitter" Grid.Column="3">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter" BasedOn="{StaticResource PanelSplitter}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=ImportPane}" Value="Visible">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>
    </Grid>
</UserControl>
