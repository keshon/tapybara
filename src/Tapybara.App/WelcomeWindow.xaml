<ui:FluentWindow x:Class="Tapybara.App.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:components="clr-namespace:Tapybara.App.Controls"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="640"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 MinHeight="0" WindowBackdropType="None" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                 WindowCornerPreference="Round"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="{StaticResource AppFontSize}">
    <!--
        Первый запуск: модель, микрофон, первая фраза.

        Раньше первый запуск выглядел так: точка в трее и уведомление на пять
        секунд «Нет модели распознавания». Для продукта это главная точка
        потерь — человек не понимает, что делать, и закрывает программу.
        Каждый шаг здесь доводит до результата, а не до настройки: модель
        скачана, микрофон слышит, первая фраза надиктована.
    -->
    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="32,0,32,24">
            <StackPanel x:Name="StepStrip" Orientation="Horizontal" Margin="0,0,0,12" />

            <TextBlock x:Name="HeadingText" Style="{StaticResource TextTitle}" />
            <TextBlock x:Name="BodyText" Style="{StaticResource TextBodySecondary}" Margin="0,8,0,24" />

            <!-- шаг 1: модель -->
            <StackPanel x:Name="ModelStep">
                <StackPanel x:Name="ModelChoices" />
                <!--
                    Строка загрузки свёрнута, пока загрузка не началась: пустая
                    строка оставляла дыру между выбором модели и примечанием.
                -->
                <StackPanel x:Name="DownloadRow" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="DownloadText" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="DownloadPercent" Style="{StaticResource TextCaption}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="DownloadProgress" Height="4" Maximum="1" />
                </StackPanel>
                <TextBlock x:Name="DetectorNote" Style="{StaticResource TextCaption}" Margin="0,8,0,0" />
            </StackPanel>

            <!-- шаг 2: микрофон -->
            <StackPanel x:Name="MicStep" Visibility="Collapsed">
                <ComboBox x:Name="MicBox" Margin="0,0,0,12" SelectionChanged="OnMicChanged" />
                <ProgressBar x:Name="MicLevel" Height="8" Maximum="1" />
            </StackPanel>

            <!-- шаг 3: проба -->
            <StackPanel x:Name="TryStep" Visibility="Collapsed">
                <ui:TextBox x:Name="TryBox"
                            MinHeight="96"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            TextChanged="OnTryChanged" />
                <TextBlock x:Name="TryDone"
                           Visibility="Collapsed"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <ui:Button x:Name="SkipButton" components:ControlSizing.Compact="True"
                           HorizontalAlignment="Left"
                           Appearance="Transparent"
                           Click="OnSkipClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BackButton" components:ControlSizing.Compact="True" MinWidth="100" Margin="0,0,8,0" Click="OnBackClick" />
                    <ui:Button x:Name="NextButton" components:ControlSizing.Compact="True" MinWidth="130" Appearance="Primary" Click="OnNextClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
