<ui:FluentWindow x:Class="Tapybara.App.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="640"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="{StaticResource AppFontSize}">
    <!--
        Первый запуск: модель, микрофон, первая фраза.

        Раньше первый запуск выглядел так: точка в трее и уведомление на пять
        секунд «Нет модели распознавания». Для продукта это главная точка
        потерь — человек не понимает, что делать, и закрывает программу.
        Каждый шаг здесь доводит до результата, а не до настройки: модель
        скачана, микрофон слышит, первая фраза надиктована.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="32,0,32,24">
            <StackPanel x:Name="StepStrip" Orientation="Horizontal" Margin="0,0,0,14" />

            <TextBlock x:Name="HeadingText"
                       FontFamily="{StaticResource AppDisplayFontFamily}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText"
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       Margin="0,6,0,18" />

            <!-- шаг 1: модель -->
            <StackPanel x:Name="ModelStep">
                <StackPanel x:Name="ModelChoices" />
                <Grid Margin="0,14,0,4">
                    <TextBlock x:Name="DownloadText" FontSize="{StaticResource AppCaptionFontSize}" Opacity="0.8" />
                    <TextBlock x:Name="DownloadPercent"
                               HorizontalAlignment="Right"
                               FontSize="{StaticResource AppCaptionFontSize}"
                               Opacity="0.8" />
                </Grid>
                <ProgressBar x:Name="DownloadProgress" Height="4" Maximum="1" Visibility="Collapsed" />
                <TextBlock x:Name="DetectorNote"
                           FontSize="{StaticResource AppCaptionFontSize}"
                           Opacity="0.65"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- шаг 2: микрофон -->
            <StackPanel x:Name="MicStep" Visibility="Collapsed">
                <ComboBox x:Name="MicBox" Margin="0,0,0,14" SelectionChanged="OnMicChanged" />
                <ProgressBar x:Name="MicLevel" Height="8" Maximum="1" />
            </StackPanel>

            <!-- шаг 3: проба -->
            <StackPanel x:Name="TryStep" Visibility="Collapsed">
                <ui:TextBox x:Name="TryBox"
                            MinHeight="96"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            TextChanged="OnTryChanged" />
                <TextBlock x:Name="TryDone"
                           Visibility="Collapsed"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <ui:Button x:Name="SkipButton"
                           HorizontalAlignment="Left"
                           Appearance="Transparent"
                           Click="OnSkipClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="BackButton" MinWidth="100" Margin="0,0,8,0" Click="OnBackClick" />
                    <ui:Button x:Name="NextButton" MinWidth="130" Appearance="Primary" Click="OnNextClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
