<ui:FluentWindow x:Class="Tapybara.App.VadTestWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="520" Height="520"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <!--
        Подбор порога детектора по образцу голоса. Правильное значение зависит
        от микрофона, комнаты и голоса — его нельзя угадать, но можно измерить.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,0">
            <TextBlock x:Name="IntroText"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,0,0,16" />

            <Border x:Name="LevelCard"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="StateText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <ProgressBar x:Name="LevelBar"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ResultsHeader"
                       FontWeight="SemiBold"
                       Visibility="Collapsed"
                       Margin="2,0,0,8" />

            <ItemsControl x:Name="ResultsList" />

            <TextBlock x:Name="RecommendationText"
                       TextWrapping="Wrap"
                       Margin="2,12,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="ApplyButton"
                           MinWidth="150"
                           Margin="0,0,8,0"
                           Appearance="Primary"
                           IsEnabled="False"
                           Click="OnApplyClick" />
                <ui:Button x:Name="StartButton"
                           MinWidth="120"
                           Click="OnStartClick" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
