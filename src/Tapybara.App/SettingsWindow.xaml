<ui:FluentWindow x:Class="Tapybara.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="1000" Height="700"
                 MinWidth="880" MaxWidth="1180"
                 MinHeight="520"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="{StaticResource AppFontSize}">
    <!--
        Разделы — страницы с боковым меню, а не один длинный скролл. Так же
        устроены «Параметры» Windows, и причина не в моде: список из семи
        пунктов виден целиком, а искать нужную настройку прокруткой простыни
        на два экрана невозможно.

        Шрифт и кегли тоже как в «Параметрах»: семейство Segoe UI Variable,
        тело 14, подпись 12, заголовок страницы 28. WPF по умолчанию берёт
        обычный Segoe UI кеглем 12, и рядом с системным окном разница заметна
        сразу.
    -->
    <ui:FluentWindow.Resources>
        <!--
            Пункт бокового меню: скруглённая подсветка выделенного и акцентная
            полоска слева. Ровно то, что рисует Windows; штатный ListBoxItem
            выглядит как таблица из девяностых.

            Собственной обводки по фокусу здесь НЕТ намеренно. Она была, и она
            неверна: «Параметры» Windows выделяют пункт только заливкой и
            полоской, а цветная рамка поверх выглядит чужеродно и появляется
            там, где пользователь ничего не выбирал клавиатурой. Обводку по
            фокусу с клавиатуры рисует сам WPF своим FocusVisualStyle — этого
            достаточно и для доступности.
        -->
        <Style x:Key="SectionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Fill"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="12,10" />
                            <Rectangle x:Name="Bar"
                                       Width="3"
                                       Height="18"
                                       RadiusX="1.5"
                                       RadiusY="1.5"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Opacity="0" />
                            <ContentPresenter Margin="12,9" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" ShowMaximize="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SectionList"
                     Grid.Column="0"
                     Margin="12,4,6,12"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource SectionItemStyle}"
                     SelectionChanged="OnSectionChanged" />

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="PageTitle"
                           Grid.Row="0"
                           FontFamily="{StaticResource AppDisplayFontFamily}"
                           FontSize="{StaticResource AppTitleFontSize}"
                           FontWeight="SemiBold"
                           Margin="12,0,24,16" />

                <ScrollViewer Grid.Row="1"
                              x:Name="PageScroll"
                              VerticalScrollBarVisibility="Auto"
                              Padding="12,0,24,16">
                    <ContentControl x:Name="PageHost" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <TextBlock x:Name="FooterHint"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           MaxWidth="620"
                           FontSize="{StaticResource AppCaptionFontSize}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
                <ui:Button x:Name="CloseButton"
                           HorizontalAlignment="Right"
                           MinWidth="100"
                           Appearance="Primary"
                           IsDefault="True"
                           Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
