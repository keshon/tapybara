<ui:FluentWindow x:Class="Tapybara.App.CallsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Tapybara.App"
                 Width="1020" Height="660"
                 MinWidth="860" MinHeight="480"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="{StaticResource AppFontSize}">
    <!--
        Записи разговоров.

        До этого окна единственным интерфейсом звонков была кнопка «открыть
        папку». Уведомление о готовом транскрипте живёт несколько секунд, и
        пропустивший его человек оставался один на один с Проводником: понять,
        распознан ли звонок, перезапустить упавшее распознавание или поправить
        имена было негде.

        Состояние выводится из файлов на диске (см. CallLibrary), поэтому оно
        не расходится с реальностью после падения приложения и переживает
        правку папки руками — а папку правят, это её назначение.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" />

        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- список -->
            <Grid Grid.Column="0" Margin="16,0,8,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="CallList"
                         Grid.Row="0"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Fill"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="12,10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Fill" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Fill" Property="Background"
                                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:CallRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="{StaticResource AppCaptionFontSize}"
                                               Opacity="0.7"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Background="{Binding StateBackground}"
                                        CornerRadius="10"
                                        Padding="9,3">
                                    <TextBlock Text="{Binding StateText}"
                                               FontSize="{StaticResource AppCaptionFontSize}"
                                               Foreground="{Binding StateForeground}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint"
                           Grid.Row="0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Opacity="0.65"
                           Margin="12,24,12,0"
                           VerticalAlignment="Top" />

                <TextBlock x:Name="TotalsText"
                           Grid.Row="1"
                           Margin="12,10,0,0"
                           FontSize="{StaticResource AppCaptionFontSize}"
                           Opacity="0.6" />
            </Grid>

            <!-- подробности выбранного -->
            <Border Grid.Column="1"
                    Margin="8,0,16,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <TextBlock x:Name="NothingSelected"
                               Margin="24"
                               TextWrapping="Wrap"
                               Opacity="0.65"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <Grid x:Name="DetailPane" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,22,24,8">
                            <StackPanel>
                                <TextBlock x:Name="DetailTitle"
                                           FontFamily="{StaticResource AppDisplayFontFamily}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="DetailMeta"
                                           FontSize="{StaticResource AppCaptionFontSize}"
                                           Opacity="0.7"
                                           Margin="0,4,0,20"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="ParticipantsLabel"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <app:ParticipantsPicker x:Name="Participants" />

                                <TextBlock x:Name="ParticipantsHint"
                                           FontSize="{StaticResource AppCaptionFontSize}"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,20" />

                                <TextBlock x:Name="NoteLabel"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <ui:TextBox x:Name="NoteBox"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            MinHeight="90"
                                            VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="20,14">
                            <Grid>
                                <ui:Button x:Name="DeleteButton"
                                           HorizontalAlignment="Left"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Click="OnDeleteClick" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button x:Name="FolderButton"
                                               Margin="0,0,8,0"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Click="OnFolderClick" />
                                    <ui:Button x:Name="TranscribeButton"
                                               Margin="0,0,8,0"
                                               Icon="{ui:SymbolIcon TextBulletListSquare24}"
                                               Click="OnTranscribeClick" />
                                    <ui:Button x:Name="OpenTranscriptButton"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon DocumentText24}"
                                               Click="OnOpenTranscriptClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
