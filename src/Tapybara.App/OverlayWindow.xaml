<Window x:Class="Tapybara.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Width"
        MinWidth="220"
        Height="46"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        AutomationProperties.Name="Tapybara dictation indicator">
    <!--
        Пилюля-индикатор поверх всех окон.

        AllowsTransparency + WindowStyle=None — попиксельная прозрачность,
        благодаря которой скруглённая «пилюля» выглядит пилюлей, а не
        прямоугольником. Это ровно то, что в WinUI 3 сделать нельзя.

        ShowActivated=False плюс WS_EX_NOACTIVATE в code-behind: окно не
        должно забирать фокус НИКОГДА — иначе текст вставится в оверлей,
        а не в приложение, куда диктовали.

        SizeToContent="Width" — потому что подписи бывают разной длины, а
        в двух языках ещё и разной на одну и ту же мысль. Фиксированная
        ширина обрезала бы русские надписи.
    -->
    <Border x:Name="Pill"
            CornerRadius="23"
            Background="#D9000000"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            MouseLeftButtonDown="OnPillPressed"
            MouseLeftButtonUp="OnPillReleased"
            MouseMove="OnPillMoved"
            Cursor="Hand"
            ToolTipService.InitialShowDelay="600">
        <Grid Margin="16,0">
            <!-- Состояние «идёт запись» -->
            <StackPanel x:Name="RecordingPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Ellipse x:Name="RecordingDot"
                         Width="9" Height="9"
                         Fill="#FF4D4D"
                         VerticalAlignment="Center" />
                <StackPanel x:Name="LevelBars"
                            Orientation="Horizontal"
                            Height="22"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center" />
                <TextBlock x:Name="ElapsedText"
                           Text="0:00"
                           Foreground="White"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HotkeyHint"
                           Foreground="#8CFFFFFF"
                           FontSize="10"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Состояние «идёт распознавание» -->
            <StackPanel x:Name="TranscribingPanel"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="TranscribingText"
                           Foreground="White"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CancelHint"
                           Foreground="#8CFFFFFF"
                           FontSize="10"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Короткая вспышка результата перед скрытием -->
            <TextBlock x:Name="NoteText"
                       Visibility="Collapsed"
                       Foreground="White"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>
