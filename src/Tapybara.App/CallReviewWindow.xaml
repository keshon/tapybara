<ui:FluentWindow x:Class="Tapybara.App.CallReviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:app="clr-namespace:Tapybara.App"
                 Width="460"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ShowActivated="False"
                 Topmost="True"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="{StaticResource AppFontSize}">
    <!--
        Карточка после звонка — у трея, в углу экрана, где появляются
        уведомления Windows.

        ShowActivated="False" здесь не мелочь. Звонок часто заканчивается в
        приложении на весь экран, и окно, забирающее фокус, перебило бы то, что
        человек в этот момент печатает. Оно показывается поверх, но управление
        забирает только по щелчку.

        Распознавание эту карточку НЕ ждёт — оно уже идёт, и прогресс виден
        здесь же. Ответ «кто был» нужен только к концу распознавания, где
        разделяются голоса. Кто из отмеченных какой голос — не спрашиваем:
        это решается потом, по цитатам, а не угадывается по порядку.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,0,24,16">
            <TextBlock x:Name="HeadingText" Style="{StaticResource TextSubtitle}" />
            <TextBlock x:Name="SubheadingText" Style="{StaticResource TextCaption}" Margin="0,2,0,12" />

            <Grid Margin="0,0,0,4">
                <TextBlock x:Name="ProgressText" Style="{StaticResource TextCaption}" />
                <TextBlock x:Name="PercentText" Style="{StaticResource TextCaption}" HorizontalAlignment="Right" />
            </Grid>
            <ProgressBar x:Name="Progress" Height="4" Maximum="100" Margin="0,0,0,16" />

            <TextBlock x:Name="TitleLabel" Style="{StaticResource TextBodyStrong}" Margin="0,0,0,8" />
            <ui:TextBox x:Name="TitleBox" Margin="0,0,0,16" KeyDown="OnTitleKeyDown" />

            <TextBlock x:Name="ParticipantsLabel" Style="{StaticResource TextBodyStrong}" Margin="0,0,0,8" />
            <app:ParticipantsPicker x:Name="Participants" />
            <TextBlock x:Name="ParticipantsHint" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <ui:Button x:Name="MoreButton"
                           HorizontalAlignment="Left"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon MoreHorizontal24}"
                           Click="OnMoreClick" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="OpenButton"
                               MinWidth="120"
                               Margin="0,0,8,0"
                               Click="OnOpenClick" />
                    <ui:Button x:Name="DoneButton"
                               MinWidth="110"
                               Appearance="Primary"
                               IsDefault="True"
                               IsCancel="True"
                               Click="OnDoneClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
