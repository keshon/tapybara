<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:Tapybara.App">
    <!--
        Общие стили окон Tapybara.

        Размеры — только из Tokens.cs (x:Static), цвета — только из темы
        WPF-UI (DynamicResource). Своих цветов здесь нет, кроме голосов
        собеседников (VoicePalette): приложение монохромное, а цвет несёт
        смысл — акцент выделяет выбранное, красный значит запись, оттенки
        голосов различают людей.
    -->

    <!-- === текст ========================================================= -->

    <!--
        Вторичный текст — кистью темы, а не прозрачностью. Прежде здесь
        было шесть разных Opacity (0.6…0.85), и серые подписи в соседних
        карточках были разными серыми.
    -->
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static app:Tokens.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{x:Static app:Tokens.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextBodySecondary" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="TextBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{x:Static app:Tokens.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextTitle" TargetType="TextBlock" BasedOn="{StaticResource TextSubtitle}">
        <Setter Property="FontSize" Value="{x:Static app:Tokens.Title}" />
    </Style>

    <!-- === поверхности =================================================== -->

    <!-- Карточка: одна для всех окон — фон, обводка, радиус, отступ. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{x:Static app:Tokens.CardRadius}" />
        <Setter Property="Padding" Value="{x:Static app:Tokens.CardPadding}" />
    </Style>

    <!-- Панель: то же, но без внутреннего отступа — внутри свой макет. -->
    <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Значок состояния в списке звонков. Цвета приходят из строки списка. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{x:Static app:Tokens.PillRadius}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- === кнопки и переключатели ======================================== -->

    <!--
        Кнопка-ссылка: метка времени, имя говорящего, «изменить». Без рамки:
        у прозрачной кнопки WPF-UI рамка остаётся, и «ссылка» выглядела
        кнопкой второго сорта.
    -->
    <Style x:Key="FlatLinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="{x:Static app:Tokens.Body}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fill"
                            Background="Transparent"
                            CornerRadius="{x:Static app:Tokens.ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Кнопка записи — пилюля индикатора (см. RecordPill). Цвета заданы
        прямо, а не темой: пилюля на экране тёмная в любой теме, и кнопка,
        которая её цитирует, тоже.
    -->
    <Style x:Key="RecordPillButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="{x:Static app:Tokens.Body}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0,16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill"
                            CornerRadius="18"
                            Background="#221C17"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#2E2620" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#17120E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Pill" Property="Opacity" Value="0.7" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Вкладка: текст и полоса акцента снизу, как у Pivot в Windows 11.
        Штатный TabControl WPF-UI рисует вкладку коробкой с рамкой, и она
        оказывалась самым тяжёлым элементом спокойной карточки, да ещё и
        не совпадала с содержимым по левому краю.
    -->
    <Style x:Key="TabHeader" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{x:Static app:Tokens.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="0,6,0,9" />
                        <Rectangle x:Name="Bar"
                                   Height="3"
                                   RadiusX="1.5" RadiusY="1.5"
                                   VerticalAlignment="Bottom"
                                   Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                   Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === поля ========================================================== -->

    <!--
        Текст реплики в транскрипте: выглядит как обычный текст, но его можно
        выделить и скопировать. TextBlock выделять не умеет, а стандартный
        TextBox рисует рамку и фон поля ввода — транскрипт превратился бы в
        стопку полей формы.
    -->
    <Style x:Key="TranscriptTextStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="FontSize" Value="{x:Static app:Tokens.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Заголовок, который правится на месте: название звонка. Рамка поля
        появляется только под мышью и в фокусе — в покое это заголовок, а не
        форма, и переименование не требует отдельной кнопки «изменить».

        Отступ поля вынесен наружу отрицательным полем: текст заголовка
        обязан стоять на одной вертикали с подписью под ним, а рамке при
        наведении всё равно нужен воздух вокруг букв.
    -->
    <Style x:Key="InlineTitleStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="-8,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{x:Static app:Tokens.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{x:Static app:Tokens.ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush"
                                    Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Frame" Property="Background"
                                    Value="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === списки ======================================================== -->

    <!--
        Строка в списке: скруглённая подсветка под мышью и у выбранной, как
        в боковом меню настроек. Справа — место под полосу прокрутки: без
        него значки состояния стояли к ней вплотную.
    -->
    <Style x:Key="ListRowStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,8,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Fill"
                            Background="Transparent"
                            CornerRadius="{x:Static app:Tokens.ControlRadius}"
                            Padding="12,8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background"
                                    Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка, которую не выбирают: реплика транскрипта, диктовка. -->
    <Style x:Key="PlainItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Заголовок группы в списке: «Сегодня», «Вчера», дата. -->
    <DataTemplate x:Key="GroupHeader">
        <TextBlock Text="{Binding Name}"
                   Style="{StaticResource TextCaption}"
                   Margin="12,12,0,4" />
    </DataTemplate>
</ResourceDictionary>
