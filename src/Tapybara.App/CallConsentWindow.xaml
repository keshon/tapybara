<ui:FluentWindow x:Class="Tapybara.App.CallConsentWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="560" Height="480"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="{StaticResource AppFontSize}">
    <!--
        Показывается один раз, перед самой первой записью звонка.

        Запись захватывает и собеседника, а во многих юрисдикциях делать это
        без его ведома незаконно. Плюс пишется весь звук устройства, а не
        только разговор. Приложение, которое начинает это молча по одному
        пункту меню, ставит человека в положение, о котором он не просил.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,8,28,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <ui:SymbolIcon Symbol="ShieldTask24"
                               FontSize="30"
                               Margin="0,0,16,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock x:Name="HeadingText"
                           FontFamily="{StaticResource AppDisplayFontFamily}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="BodyText"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,0,0,16" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16">
                <TextBlock x:Name="PointsText"
                           TextWrapping="Wrap"
                           LineHeight="21" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CancelButton"
                           MinWidth="120"
                           Margin="0,0,8,0"
                           IsCancel="True"
                           Click="OnCancelClick" />
                <ui:Button x:Name="AcceptButton"
                           MinWidth="200"
                           Appearance="Primary"
                           Click="OnAcceptClick" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
