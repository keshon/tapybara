<ui:FluentWindow x:Class="Tapybara.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Tapybara"
                 Width="1280" Height="800"
                 MinWidth="1060" MinHeight="540"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="{StaticResource AppFontSize}">
    <!--
        Главное окно Tapybara.

        Раньше у приложения окна не было вовсе: всё сходилось в меню трея,
        и то, чем пользуются каждый день (звонки, история), стояло там
        вперемешку с тем, что нужно раз в жизни (папка моделей, автозапуск).
        Здесь — то, к чему возвращаются: диктовки, звонки, словарь. Настройки
        остаются отдельным окном, как в больших программах: туда заходят
        редко, и держать их на равных с работой незачем.

        Слева — узкая полоса разделов со значками, как в приложениях
        Windows 11: страницам нужна ширина, а разделов всего три.
    -->
    <ui:FluentWindow.Resources>
        <Style x:Key="RailButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Fill" Background="Transparent" CornerRadius="6" />
                            <Rectangle x:Name="Bar"
                                       Width="3" Height="18"
                                       RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="0,14,0,0"
                                       Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Opacity="0" />
                            <ContentPresenter Margin="2,9,2,7" HorizontalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="WindowTitleBar" Title="Tapybara" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="6,0,4,12" LastChildFill="False">
                <RadioButton x:Name="DictationsNav"
                             DockPanel.Dock="Top"
                             GroupName="Nav"
                             Style="{StaticResource RailButtonStyle}"
                             Checked="OnNavChecked">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Mic24" FontSize="21" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DictationsNavText" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="CallsNav"
                             DockPanel.Dock="Top"
                             GroupName="Nav"
                             Style="{StaticResource RailButtonStyle}"
                             Checked="OnNavChecked">
                    <StackPanel>
                        <Grid HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Call24" FontSize="21" />
                            <!-- Звонок ждёт имён — точка, как у непрочитанного. -->
                            <Ellipse x:Name="CallsAttention"
                                     Width="8" Height="8"
                                     Margin="0,0,-4,0"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Visibility="Collapsed"
                                     Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <TextBlock x:Name="CallsNavText" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="DictionaryNav"
                             DockPanel.Dock="Top"
                             GroupName="Nav"
                             Style="{StaticResource RailButtonStyle}"
                             Checked="OnNavChecked">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Book24" FontSize="21" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DictionaryNavText" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </RadioButton>

                <!--
                    Настройки — не раздел, а кнопка: они открываются отдельным
                    окном. Внизу полосы, как у «Параметров» в приложениях
                    Windows, — отдельно от того, чем пользуются каждый день.
                -->
                <RadioButton x:Name="SettingsNav"
                             DockPanel.Dock="Bottom"
                             GroupName="SettingsNav"
                             Style="{StaticResource RailButtonStyle}"
                             Checked="OnSettingsChecked">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Settings24" FontSize="21" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SettingsNavText" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </DockPanel>

            <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />
        </Grid>
    </Grid>
</ui:FluentWindow>
